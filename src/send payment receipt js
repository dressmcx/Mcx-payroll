const resend = new Resend(process.env.RESEND_API_KEY);

async function sendPaymentReceipt(workerData) {
  // Logic to ensure only your 4 specific methods are used
  const validMethods = ['Cash', 'Zelle', 'Store Credit', 'Check'];
  const method = validMethods.includes(workerData.payment_type) 
                 ? workerData.payment_type 
                 : 'Check'; // Default fallback

  try {
    const data = await resend.emails.send({
      from: 'MCX Payments <payments@yourdomain.com>', // Use your verified domain here
      to: [workerData.email],
      subject: 'Payment Confirmed - Thank you for your hard work! 🌟',
      html: emailHtml // This uses the template from above
    });

    console.log('Receipt sent successfully:', data);
  } catch (error) {
    console.error('Error sending receipt:', error);
